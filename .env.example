# Prego Environment Variables
# Copy this file to .env and fill in values

# Stripe (required for payment features)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App config
APP_URL=https://prego.ashbi.ca
PORT=3000

# Deployment
COOLIFY_TOKEN=

# Public native SDK keys only; never put RevenueCat secret API keys here.
# Keep purchases disabled until products, clinical review and store QA pass.
VITE_PURCHASES_ENABLED=false
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=
